# ==========================================================
# Silaimozhi - Production .gitignore
# ==========================================================

# --- Secrets, Credentials & Local Environments ---
.env
.env.*
!.env.example
*.local
*.pem
*.key
*.cert
*.crt
credentials.json

# --- Python Backend & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
python_backend/venv/
python_backend/env/
python_backend/.venv/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
instance/
.webassets-cache

# --- Databases & SQLite Binaries ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
kalvettu.db

# --- Frontend (Node / React / Vite) ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.timestamp-*.mjs
frontend/vite.config.ts.timestamp-*

# --- OS & IDE Configurations ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/
*.code-workspace

# --- Logs ---
logs/
*.log

# --- Scratch & Internal AI Cache ---
scratch/
crap/
.workbuddy-ai/
.gemini/
*.zip
*.tar.gz
*.gz
